<configs>
	<!-- Oxygen Destroyer part quests, offered by the trader in each part city (KaijuPartQuests.cs
	     puts them at the top of the job list and presets the Goto destination: the part site). -->
	<append xpath="/quests">
		<quest id="kaijuPart1">
			<property name="name_key" value="kaijuPartQuest1"/>
			<property name="subtitle_key" value="kaijuPartQuest_subtitle"/>
			<property name="description_key" value="kaijuPartQuest1Desc"/>
			<property name="offer_key" value="kaijuPartQuest1Offer"/>
			<property name="icon" value="ui_game_symbol_airdrop"/>
			<property name="category_key" value="quest"/>
			<property name="difficulty_tier" value="3"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="TurnIn"/>
			<property name="completion_key" value="kaijuPartQuest_completion"/>

			<objective type="Goto" id="kaijupart" value="40" phase="1">
				<property name="nav_object" value="quest"/>
			</objective>

			<objective type="FetchKeep" id="kaijuOxygenDestroyerPart1" value="1" phase="2"/>

			<objective type="ReturnToNPC">
				<property name="phase" value="3"/>
				<property name="nav_object" value="return_to_trader"/>
			</objective>

			<objective type="InteractWithNPC">
				<property name="phase" value="3"/>
				<property name="nav_object" value="return_to_trader"/>
			</objective>

			<reward type="Exp" value="4500"/>
			<reward type="Item" id="casinoCoin" value="450"/>
		</quest>
