<configs>
	<append xpath="/blocks">
		<!-- Part crates: a hero chest whose loot list holds exactly one part. The mod places one in
		     the military site by each end city and lights it. Godzilla's footprint and breath skip every block named kaiju*. -->
		<block name="kaijuPartCrate1">
			<property name="Extends" value="cntLootChestHeroInsecureT1"/>
			<property name="CreativeMode" value="Dev"/>
			<property name="CustomIcon" value="cntLootChestHeroInsecureT1"/>
			<property name="DescriptionKey" value="kaijuPartCrateDesc"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="false"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="kaijuPart1"/>
				</property>
			</property>
		</block>
		<block name="kaijuPartCrate2">
			<property name="Extends" value="kaijuPartCrate1"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="kaijuPart2"/>
				</property>
			</property>
		</block>
		<block name="kaijuPartCrate3">
			<property name="Extends" value="kaijuPartCrate1"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="kaijuPart3"/>
				</property>
			</property>
		</block>
		<block name="kaijuPartCrate4">
			<property name="Extends" value="kaijuPartCrate1"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="kaijuPart4"/>
				</property>
			</property>
		</block>
		<block name="kaijuPartCrate5">
			<property name="Extends" value="kaijuPartCrate1"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="kaijuPart5"/>
				</property>
			</property>
		</block>

		<!-- The Oxygen Destroyer: crafted from the five parts and dropped on him from a gyrocopter
		     (the mod handles the drop). A block so it keeps its model; placed, it can be picked up again. -->
		<block name="kaijuOxygenDestroyer">
			<property name="CustomIcon" value="tankPropaneWhite"/>
			<property name="CustomIconTint" value="7fd4ff"/>
			<property name="TintColor" value="7fd4ff"/>
			<property name="DescriptionKey" value="kaijuOxygenDestroyerDesc"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Industrial/tankPropanePrefab.prefab"/>
			<property name="MultiBlockDim" value="5,2,2"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="Collide" value="sight,movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="true"/>
			<property name="EconomicValue" value="0"/>
			<property name="SellableToTrader" value="false"/>
			<property name="CreativeMode" value="Player"/>
			<property name="FilterTags" value="MC_building,SC_decor"/>
			<property name="SortOrder1" value="B672"/>
			<drop event="Destroy" count="0"/>
		</block>

		<!-- Weapons the mod places in the army posts (KaijuRun): the missile battery's launch control
		     above Cinder Bay, the airstrike radio above Dune Point, the maser cannon and its three
		     generators above Frostport. Class resolves to BlockKaijuWeapon in KaijuMod.dll; named
		     kaiju* so his footprint and breath never destroy them. -->
		<block name="kaijuMissileControl">
			<property name="Class" value="KaijuWeapon, KaijuMod"/>
			<property name="DescriptionKey" value="kaijuMissileControlDesc"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Industrial/controlPanelBase_01Prefab.prefab"/>
			<property name="CustomIcon" value="controlPanelBase01"/>
			<property name="Collide" value="sight,movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="false"/>
			<property name="CreativeMode" value="Dev"/>
			<drop event="Destroy" count="0"/>
		</block>
		<block name="kaijuAirstrikeRadio">
			<property name="Class" value="KaijuWeapon, KaijuMod"/>
			<property name="DescriptionKey" value="kaijuAirstrikeRadioDesc"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Electrical/radioHamPrefab.prefab"/>
			<property name="CustomIcon" value="radioHam"/>
			<property name="Collide" value="sight,movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="false"/>
			<property name="CreativeMode" value="Dev"/>
			<drop event="Destroy" count="0"/>
		</block>
		<block name="kaijuMaserCannon">
			<property name="Class" value="KaijuWeapon, KaijuMod"/>
			<property name="DescriptionKey" value="kaijuMaserCannonDesc"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Electrical/satelliteUnit3X3LargePrefab.prefab"/>
			<property name="CustomIcon" value="satelliteUnitLarge"/>
			<property name="DisplayType" value="blockMulti"/>
			<property name="MultiBlockDim" value="3,3,3"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="Collide" value="sight,movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="false"/>
			<property name="CreativeMode" value="Dev"/>
			<drop event="Destroy" count="0"/>
		</block>
		<block name="kaijuMaserGenerator">
			<property name="Class" value="KaijuWeapon, KaijuMod"/>
			<property name="DescriptionKey" value="kaijuMaserGeneratorDesc"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Electrical/generatorBankAPrefab.prefab"/>
			<property name="CustomIcon" value="generatorBankA"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="Collide" value="sight,movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="100000"/>
			<property name="CanPickup" value="false"/>
			<property name="CreativeMode" value="Dev"/>
			<drop event="Destroy" count="0"/>
		</block>
	</append>
</configs>
