<configs>
  <!--
    Phase 1 prototype: a scaled-up vanilla brute, console-spawn only.
    Purpose: feel the scale and reproduce the known AI problems before writing C#.
    Test in game: spawnentity <yourEntityId> zombieKaiju
  -->
  <append xpath="/entity_classes">
    <entity_class name="zombieKaiju" extends="zombieMutated">
      <!-- Phase 2 swaps this for our own bundle:
           <property name="Mesh" value="#@modfolder:Resources/kaiju.unity3d?KaijuPrefab"/> -->
      <property name="SizeScale" value="3"/>
      <property name="Tags" value="entity,zombie,walker,boss,kaiju"/>
      <property name="ExperienceGain" value="20000"/>
      <property name="LootDropProb" value="1"/>
      <property name="LootDropEntityClass" value="EntityLootContainerBoss"/>
      <property name="UserSpawnType" value="Console"/>

      <effect_group name="Base Effects">
        <passive_effect name="HealthMax" operation="base_set" value="20000"/>
      </effect_group>
    </entity_class>
  </append>
</configs>
