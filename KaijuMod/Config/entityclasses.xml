<configs>
	<!-- G-cell zombies: the fallout carries Godzilla's cells and the dead it touches get back up.
	     Radiated, charged and infernal zombies glow his atomic blue, brighter each stage (MatColor
	     sets their _EmissiveColor; alpha + 1 is the emissive power). Their skins darken and grow
	     scales in code (KaijuGCell). -->
	<set xpath="/entity_classes/color[@name='radiated']/@value">0.2,0.65,1.6, 0.3</set>
	<set xpath="/entity_classes/color[@name='charged']/@value">0.3,0.75,2.2, 0.6</set>
	<set xpath="/entity_classes/color[@name='infernal']/@value">0.55,0.85,3, 1</set>
</configs>
